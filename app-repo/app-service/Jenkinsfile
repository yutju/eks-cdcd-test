pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
  namespace: jenkins-build
spec:
  serviceAccountName: jenkins-build-agent
  containers:
  - name: kubectl
    image: alpine:latest
    command: ["sleep"]
    args: ["infinity"]
    securityContext:
      runAsUser: 0
    envFrom:
    - configMapRef:
        name: jenkins-infra-config
    resources:
      requests:
        memory: "256Mi"
        cpu: "200m"
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["infinity"]
    resources:
      requests:
        memory: "3Gi"
        cpu: "1"
      limits:
        memory: "4Gi"
  # [신규] Trivy 이미지 취약점/시크릿 스캔 전용 컨테이너
  - name: trivy
    image: aquasec/trivy:latest
    command: ["sleep"]
    args: ["infinity"]
    resources:
      requests:
        memory: "512Mi"
        cpu: "200m"
      limits:
        memory: "1Gi"
"""
        }
    }
    // [신규] 동시 빌드 금지 — 두 빌드가 동시에 gitops-repo에 push하면
    // 이미지 태그가 꼬이므로 (build-8/10 혼선 같은 상황 방지)
    options {
        disableConcurrentBuilds()
    }
    // [시연용] 불량 빌드 토글. 평소(웹훅 자동빌드)엔 false로 정상 빌드,
    // "Build with Parameters"에서 체크하면 요청 30%를 500으로 내는 이미지를 빌드해서
    // 카나리 자동 롤백(시나리오 2)을 파이프라인 끝까지 재현할 수 있음.
    parameters {
        booleanParam(name: 'FAIL_MODE', defaultValue: false,
            description: '체크 시 불량 이미지(요청 30% 500) 빌드 → 카나리 분석 실패 → 8단계 자동 롤백 시연')
    }
    environment {
        GITLAB_API_TOKEN    = credentials('gitlab-token-id')
        GITLAB_URL          = "${env.GITLAB_URL ?: 'http://10.0.4.10:8080'}"
        GITLAB_PROJECT_ID   = "root%2Fapp-repo"
        JENKINS_WEBHOOK_BASE_URL = "http://jenkins.his-main.internal:8080/generic-webhook-trigger/invoke"
        GENERIC_TRIGGER_TOKEN    = "jenkins-app-service-secret"
        AWS_REGION          = "ap-northeast-2"
        ECR_REPO_NAME       = "web-service/app-image"
        IMAGE_TAG           = "build-${BUILD_NUMBER}"
    }

    // [변경] gitlab() 트리거는 리포지토리 전체 push에 반응해서, openemr/만 바뀌어도
    // 이 파이프라인이 매번 트리거됨. GenericTrigger + 경로 필터로 app-service/ 변경이
    // 없으면 빌드 자체가 시작되지 않게 함.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added', value: '$.commits[*].added[*]'],
                [key: 'removed', value: '$.commits[*].removed[*]']
            ],
            causeString: 'GitLab push 감지 (app-service 경로 필터)',
            token: 'jenkins-app-service-secret',
            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            regexpFilterText: '$ref $modified $added $removed',
            regexpFilterExpression: '^refs/heads/main.*app-service/.*$'
        )
    }

    stages {
        stage('0. 기본 에이전트 도구 주입') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl openssl bash git aws-cli
                        curl -sLO "https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                        # [카나리] Rollout 상태 확인용 kubectl 플러그인
                        curl -sLo /usr/local/bin/kubectl-argo-rollouts \
                            "https://github.com/argoproj/argo-rollouts/releases/latest/download/kubectl-argo-rollouts-linux-amd64"
                        chmod +x /usr/local/bin/kubectl-argo-rollouts
                    '''
                }
            }
        }

        // [수정] container('kubectl')로 명시. 지정 안 하면 기본 컨테이너(jnlp)에서 실행되어
        // stage 0에서 설치한 git/aws-cli를 못 찾을 수 있음.
        stage('1. 코드 체크아웃') {
            steps {
                container('kubectl') {
                    checkout scm
                }
            }
        }

        // [수정] HEAD~1이 없는 경우(첫 커밋/얕은 클론)를 명시적으로 처리.
        stage('1.5 변경 경로 확인') {
            steps {
                container('kubectl') {
                    script {
                        def changed = sh(
                            script: '''
                                if git rev-parse --verify HEAD~1 >/dev/null 2>&1; then
                                    git diff --name-only HEAD~1 HEAD
                                else
                                    echo "__FULL_BUILD__"
                                fi
                            ''',
                            returnStdout: true
                        ).trim()

                        if (changed == "__FULL_BUILD__") {
                            echo "비교 기준 커밋 없음(첫 커밋/얕은 클론) — 안전하게 빌드 진행"
                            env.APP_CHANGED = 'true'
                        } else if (changed.contains('app-service/')) {
                            env.APP_CHANGED = 'true'
                        } else {
                            echo "app-service 변경 없음 — 이후 스테이지 스킵"
                            env.APP_CHANGED = 'false'
                        }
                    }
                }
            }
        }

        // [신규] 시크릿 스캔 — 소스에 하드코딩된 자격증명(비밀번호/토큰/키)이 커밋됐는지 검사.
        // 발견 시 빌드 차단. 오탐은 app-service/.trivyignore 에 룰 ID 등록으로 예외 처리.
        stage('1.7 Trivy 시크릿 스캔') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('trivy') {
                    sh """
                        trivy fs --scanners secret --exit-code 1 --no-progress app-service/
                    """
                }
            }
        }

        // [수정] error()로 중단하지 않고 when 조건으로 스킵 — NOT_BUILT 표시 유지.
        // [수정] 훅 중복확인 grep을 토큰 기준으로 — 베이스 URL은 openemr 파이프라인과 동일해서
        //   토큰 없는 매칭이면 서로의 훅을 "이미 있음"으로 오판해 자기 훅 등록을 건너뜀.
        stage('2. GitLab 웹훅 자동 등록') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        def gitlabApiBase = "${env.GITLAB_URL}/api/v4"
                        sh """
                            EXISTING_HOOK=\$(curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --silent "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" | grep "token=${env.GENERIC_TRIGGER_TOKEN}" || true)
                            if [ -z "\$EXISTING_HOOK" ]; then
                                curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --request POST -G "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" \\
                                    --data-urlencode "url=${env.JENKINS_WEBHOOK_BASE_URL}?token=${env.GENERIC_TRIGGER_TOKEN}" \\
                                    --data-urlencode "push_events=true" \\
                                    --data-urlencode "enable_ssl_verification=false"
                            fi
                        """
                    }
                }
            }
        }

        stage('3. Docker Image Build & ECR Push (Kaniko)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                script {
                    def awsAccountId = ""
                    container('kubectl') {
                        awsAccountId = sh(script: "aws sts get-caller-identity --query 'Account' --output text", returnStdout: true).trim()
                    }
                    container('kaniko') {
                        def ecrRegistry = "${awsAccountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        def ecrImageUri = "${ecrRegistry}/${env.ECR_REPO_NAME}:${env.IMAGE_TAG}"
                        // [시연] build-arg로 (1)버전 태그를 이미지에 굽고(/api/version이 반환 → 대시보드 구분),
                        //        (2)FAIL_MODE 파라미터를 이미지에 반영(불량 빌드 시연).
                        sh """
                            mkdir -p /kaniko/.docker
                            echo '{"credsStore":"ecr-login"}' > /kaniko/.docker/config.json
                            /kaniko/executor \\
                                --context \$(pwd)/app-service \\
                                --dockerfile \$(pwd)/app-service/Dockerfile \\
                                --destination ${ecrImageUri} \\
                                --build-arg APP_VERSION=${env.IMAGE_TAG} \\
                                --build-arg FAIL_MODE=${params.FAIL_MODE}
                        """
                        env.ECR_IMAGE_URI = ecrImageUri
                    }
                }
            }
        }

        // [신규] 취약점 스캔 게이트 — HIGH 이상은 리포트, CRITICAL 있으면 빌드 실패(배포 전 차단).
        // ECR 인증은 에이전트 SA의 IRSA로 자동 처리.
        // [수정] 기본 출력이 모든 package.json을 clean(0)으로 나열해 로그를 도배함 →
        //   리포트를 파일로 받아 'node-pkg' 요약 라인을 숨기고 실제 HIGH/CRITICAL만 출력.
        //   게이트는 결과를 버려(exit code만 사용) 두 번째 거대 테이블도 안 뜨게 함.
        //   시크릿 스캔은 1.7단계에서 했으므로 여기선 --scanners vuln 으로 생략.
        stage('3.5 Trivy 이미지 취약점 스캔') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('trivy') {
                    sh """
                        # 1) 리포트 생성(실패 안 함) → 파일로
                        trivy image --severity HIGH,CRITICAL --no-progress --scanners vuln \\
                            --exit-code 0 ${env.ECR_IMAGE_URI} > trivy-report.txt 2>&1 || true
                        echo "───── Trivy HIGH/CRITICAL 취약점 상세 ─────"
                        # 맨 위 'Report Summary'(수백 개 clean 패키지 목록)는 건너뛰고
                        # 실제 취약점 상세 테이블('Total:' 줄부터)만 출력
                        if grep -q "Total:" trivy-report.txt; then
                            sed -n '/Total:/,\$p' trivy-report.txt
                        else
                            echo "HIGH/CRITICAL 취약점 없음"
                        fi
                        echo "────────────────────────────────────────────"
                        # 2) 게이트: CRITICAL 존재 시 빌드 실패 (출력은 버리고 exit code만 사용)
                        trivy image --severity CRITICAL --no-progress --scanners vuln \\
                            --exit-code 1 --quiet ${env.ECR_IMAGE_URI} > /dev/null 2>&1
                    """
                }
            }
        }

        stage('4. GitOps 테스트 환경 반영') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        deployToGitOps(
                            'kubernetes/apps/app-service-test/deployment.yaml',
                            env.ECR_IMAGE_URI,
                            "app-service-test image update (${env.IMAGE_TAG})",
                            'app-service-test'
                        )
                    }
                }
            }
        }

        stage('5. 테스트 환경 배포 대기') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    // [수정] 300s → 600s: 노드 증설(EC2 기동) + 이미지 pull 시간 고려
                    sh "kubectl rollout status deployment/app-service -n web-apps-test --timeout=600s"
                }
            }
        }

        stage('6. 배포 승인 대기 (QA)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                script {
                    timeout(time: 24, unit: 'HOURS') {
                        // [수정] input 반환값을 받아야 승인자가 기록됨(기존엔 "approved by null")
                        env.DEPLOY_APPROVER = input(
                            message: "테스트 환경(web-apps-test) QA가 완료되었습니다. 상용(app-service-prod)에 동일 이미지(${env.IMAGE_TAG})를 배포할까요?",
                            ok: '배포 진행',
                            submitterParameter: 'DEPLOY_APPROVER'
                        )
                    }
                }
            }
        }

        stage('7. GitOps 상용 환경 반영') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        // 배포 직전 이미지를 기록 - 카나리 실패 시 이 값으로 자동 롤백
                        env.PROD_PREV_IMAGE_URI = deployToGitOps(
                            'kubernetes/apps/app-service-prod/rollout.yaml',
                            env.ECR_IMAGE_URI,
                            "app-service-prod image update (${env.IMAGE_TAG}) - approved by ${env.DEPLOY_APPROVER}",
                            'app-service-prod'
                        )
                    }
                }
            }
        }

        stage('8. 카나리 배포 진행 확인 (실패 시 자동 롤백)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        // [수정 1] 레이스 방지: ArgoCD가 새 이미지를 Rollout에 반영하기 전에
                        // status를 부르면 "이전 상태의 Healthy"를 성공으로 오판함.
                        // 새 이미지가 라이브 Rollout spec에 반영될 때까지 대기(최대 3분).
                        def synced = sh(
                            script: """
                                for i in \$(seq 1 36); do
                                    CURRENT=\$(kubectl get rollout app-service -n web-apps -o jsonpath='{.spec.template.spec.containers[0].image}')
                                    if [ "\$CURRENT" = "${env.ECR_IMAGE_URI}" ]; then
                                        echo "새 이미지 반영 확인: \$CURRENT"
                                        exit 0
                                    fi
                                    sleep 5
                                done
                                echo "3분 내에 새 이미지가 Rollout에 반영되지 않음 (ArgoCD sync 확인 필요)"
                                exit 1
                            """,
                            returnStatus: true
                        )
                        if (synced != 0) {
                            error("ArgoCD sync 실패 - 새 이미지가 클러스터에 반영되지 않았습니다. ArgoCD 상태를 확인하세요.")
                        }

                        // 컨트롤러가 카나리 절차를 시작할 시간
                        sh "sleep 10"

                        // 카나리 완주 대기: 10% → 분석(~2.5분) → 50% → 60초 → 100%
                        def canaryResult = sh(
                            script: "kubectl argo rollouts status app-service -n web-apps --timeout 900s",
                            returnStatus: true
                        )

                        if (canaryResult != 0) {
                            echo "카나리 실패 감지 - 롤백 절차 시작"
                            // 트래픽 즉시 차단(분석 실패면 이미 abort됐지만, 다른 실패 경로 대비 안전장치)
                            sh "kubectl argo rollouts abort app-service -n web-apps || true"

                            if (env.PROD_PREV_IMAGE_URI == null || env.PROD_PREV_IMAGE_URI.contains("placeholder")) {
                                error("카나리 실패 - 되돌릴 이전 정상 버전이 없어(최초 배포) git 롤백을 건너뜀. 수동 확인 필요.")
                            }

                            // [수정 2] 롤백 대상 태그가 ECR에 실제 존재하는지 검증.
                            // ECR 재생성 등으로 이전 태그가 사라진 경우, 없는 태그를 git에 쓰면
                            // ImagePullBackOff만 유발하므로 롤백 중단하고 수동 개입 요청.
                            def prevTag = env.PROD_PREV_IMAGE_URI.tokenize(':').last()
                            def tagExists = sh(
                                script: "aws ecr describe-images --repository-name ${env.ECR_REPO_NAME} --image-ids imageTag=${prevTag} --region ${env.AWS_REGION} >/dev/null 2>&1",
                                returnStatus: true
                            )
                            if (tagExists != 0) {
                                error("카나리 실패 + 롤백 불가: 이전 태그(${prevTag})가 ECR에 없습니다. " +
                                      "트래픽은 abort로 stable에 묶여 있으나 git 정합성 복구는 수동 필요 — " +
                                      "ECR에 존재하는 태그로 rollout.yaml을 직접 수정하세요.")
                            }

                            echo "이전 버전(${env.PROD_PREV_IMAGE_URI})으로 git 롤백합니다."
                            deployToGitOps(
                                'kubernetes/apps/app-service-prod/rollout.yaml',
                                env.PROD_PREV_IMAGE_URI,
                                "ROLLBACK: 카나리 실패로 자동 롤백 (${env.IMAGE_TAG} 배포 취소)",
                                'app-service-prod'
                            )
                            sh "kubectl argo rollouts status app-service -n web-apps --timeout 300s"
                            error("카나리 실패 - 이전 버전(${env.PROD_PREV_IMAGE_URI})으로 롤백 완료. ${env.IMAGE_TAG} 배포는 취소됨.")
                        } else {
                            echo "카나리 배포 성공 - 100% 전환 완료 (${env.IMAGE_TAG})"
                        }
                    }
                }
            }
        }
    }
}

// gitops-repo를 clone -> sed로 이미지 태그 치환 -> commit/push
// 반환값: 교체되기 전 이미지 URI (롤백 시 이 값으로 되돌리기 위해 호출부에서 기록)
def deployToGitOps(String targetDeploymentPath, String imageUri, String commitMsg, String argoAppName) {
    def prevImageFile = "prev_image_${argoAppName}.txt"
    withCredentials([usernamePassword(credentialsId: 'gitlab-checkout-cred', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
        sh """
            git config --global user.email "jenkins@jenkins.com"
            git config --global user.name "Jenkins-CI"
            git config --global http.sslVerify false
            rm -rf gitops-repo-tmp
            CLEAN_PASSWORD=\$(echo -n "\${GIT_PASSWORD}" | tr -d '\\n\\r')
            CLEAN_USERNAME=\$(echo -n "\${GIT_USERNAME}" | tr -d '\\n\\r')
            # [보안] set +x: clone URL에 토큰이 포함되므로 명령 echo를 꺼서
            # 콘솔 로그에 자격증명이 평문으로 찍히는 것을 방지
            set +x
            git clone -b main "http://\${CLEAN_USERNAME}:\${CLEAN_PASSWORD}@10.0.4.10:8080/root/gitops-repo.git" gitops-repo-tmp
            set -x
            grep "image:" gitops-repo-tmp/${targetDeploymentPath} | awk '{print \$2}' > ${prevImageFile}
            sed -i "s|image: .*|image: ${imageUri}|g" gitops-repo-tmp/${targetDeploymentPath}
            cd gitops-repo-tmp
            git add ${targetDeploymentPath}
            git commit -m "${commitMsg}"
            # [수정] push 충돌 시 1회 재시도 (그 사이 다른 커밋이 들어온 경우)
            set +x
            git push origin main || (git pull --rebase origin main && git push origin main)
            set -x
        """
    }
    // push 직후 hard-refresh로 ArgoCD가 즉시 재비교 + sync하도록 유도
    sh """
        kubectl patch application ${argoAppName} -n argocd --type merge \
            -p '{"metadata":{"annotations":{"argocd.argoproj.io/refresh":"hard"}}}'
    """
    return readFile(prevImageFile).trim()
}
