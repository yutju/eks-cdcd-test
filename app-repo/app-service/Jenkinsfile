~                                                                                                          pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
  namespace: jenkins-build
spec:
  serviceAccountName: jenkins-build-agent
  containers:
  - name: kubectl
    image: alpine:latest
    command: ["sleep"]
    args: ["infinity"]
    securityContext:
      runAsUser: 0
    envFrom:
    - configMapRef:
        name: jenkins-infra-config
    resources:
      requests:
        memory: "256Mi"
        cpu: "200m"
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["infinity"]
    resources:
      requests:
        memory: "3Gi"
        cpu: "1"
      limits:
        memory: "4Gi"
"""
        }
    }

    environment {
        GITLAB_API_TOKEN    = credentials('gitlab-token-id')
        GITLAB_URL          = "${env.GITLAB_URL ?: 'http://10.0.4.10:8080'}"
        GITLAB_PROJECT_ID   = "root%2Fapp-repo"
        JENKINS_WEBHOOK_BASE_URL = "http://jenkins.his-main.internal:8080/generic-webhook-trigger/invoke"
        GENERIC_TRIGGER_TOKEN    = "jenkins-app-service-secret"
        AWS_REGION          = "ap-northeast-2"
        ECR_REPO_NAME       = "web-service/app-image"
        IMAGE_TAG           = "build-${BUILD_NUMBER}"
    }

    // [변경] gitlab() 트리거는 리포지토리 전체 push에 반응해서, openemr/만 바뀌어도
    // 이 파이프라인이 매번 트리거됨(1.5단계에서 스킵은 되지만 에이전트 파드가 불필요하게 뜸).
    // GenericTrigger + 경로 필터로 바꿔서, app-service/ 변경이 없으면
    // 빌드 자체가 아예 시작되지 않게 함.
    // 주의: JSONPath 추출 결과는 Jenkins Job 설정 화면의 GenericTrigger
    // "webhook 테스트" 기능으로 실제 GitLab payload에 맞게 한번 검증 필요.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added', value: '$.commits[*].added[*]'],
                [key: 'removed', value: '$.commits[*].removed[*]']
            ],
            causeString: 'GitLab push 감지 (app-service 경로 필터)',
            token: 'jenkins-app-service-secret',
            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            regexpFilterText: '$ref $modified $added $removed',
            regexpFilterExpression: '^refs/heads/main.*app-service/.*$'
        )
    }

    stages {
        stage('0. 기본 에이전트 도구 주입') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl openssl bash git aws-cli
                        curl -sLO "https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                        # [카나리] Rollout 상태 확인용 kubectl 플러그인
                        curl -sLo /usr/local/bin/kubectl-argo-rollouts \
                            "https://github.com/argoproj/argo-rollouts/releases/latest/download/kubectl-argo-rollouts-linux-amd64"
                        chmod +x /usr/local/bin/kubectl-argo-rollouts
                    '''
                }
            }
        }

        // [수정] container('kubectl')로 명시. container를 지정하지 않으면
        // Kubernetes 플러그인 기본 컨테이너(jnlp)에서 실행되어 stage 0에서 설치한
        // git/aws-cli를 찾지 못해 실패할 수 있음.
        stage('1. 코드 체크아웃') {
            steps {
                container('kubectl') {
                    checkout scm
                }
            }
        }

        // [수정] HEAD~1이 없는 경우(첫 커밋, shallow clone depth 부족 등)를 명시적으로 처리.
        // 기존에는 `|| true`로 삼켜져서 changed가 빈 문자열이 되고,
        // 그 결과 정상적인 변경 사항도 "변경 없음"으로 오판되어 스킵될 위험이 있었음.
        // 이제는 비교 기준 커밋이 없으면 안전하게 "빌드 진행"으로 처리함.
        stage('1.5 변경 경로 확인') {
            steps {
                container('kubectl') {
                    script {
                        def changed = sh(
                            script: '''
                                if git rev-parse --verify HEAD~1 >/dev/null 2>&1; then
                                    git diff --name-only HEAD~1 HEAD
                                else
                                    echo "__FULL_BUILD__"
                                fi
                            ''',
                            returnStdout: true
                        ).trim()

                        if (changed == "__FULL_BUILD__") {
                            echo "비교 기준 커밋 없음(첫 커밋/얕은 클론) — 안전하게 빌드 진행"
                            env.APP_CHANGED = 'true'
                        } else if (changed.contains('app-service/')) {
                            env.APP_CHANGED = 'true'
                        } else {
                            echo "app-service 변경 없음 — 이후 스테이지 스킵"
                            env.APP_CHANGED = 'false'
                        }
                    }
                }
            }
        }

        // [수정] error()로 파이프라인을 강제 중단하지 않고 when 조건으로 스킵.
        // 기존 방식은 error() 호출 시 currentBuild.result가 FAILURE로 재설정되어
        // 의도한 NOT_BUILT(스킵)가 아니라 "빌드 실패"로 잘못 표시되는 문제가 있었음.
        stage('2. GitLab 웹훅 자동 등록') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        def gitlabApiBase = "${env.GITLAB_URL}/api/v4"
                        // -G: --data-urlencode 값들을 POST body가 아니라 URL 쿼리스트링으로 붙임
                        // (이 GitLab 인스턴스의 hooks API가 body 방식은 안 받아서 쿼리스트링 방식 유지,
                        //  단 특수문자(? 등)는 -G + --data-urlencode 조합으로 안전하게 인코딩됨)
                        sh """
                            EXISTING_HOOK=\$(curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --silent "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" | grep "${env.JENKINS_WEBHOOK_BASE_URL}" || true)
                            if [ -z "\$EXISTING_HOOK" ]; then
                                curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --request POST -G "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" \\
                                    --data-urlencode "url=${env.JENKINS_WEBHOOK_BASE_URL}?token=${env.GENERIC_TRIGGER_TOKEN}" \\
                                    --data-urlencode "push_events=true" \\
                                    --data-urlencode "enable_ssl_verification=false"
                            fi
                        """
                    }
                }
            }
        }

        stage('3. Docker Image Build & ECR Push (Kaniko)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                script {
                    def awsAccountId = ""
                    container('kubectl') {
                        awsAccountId = sh(script: "aws sts get-caller-identity --query 'Account' --output text", returnStdout: true).trim()
                    }
                    container('kaniko') {
                        def ecrRegistry = "${awsAccountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        def ecrImageUri = "${ecrRegistry}/${env.ECR_REPO_NAME}:${env.IMAGE_TAG}"
                        sh """
                            mkdir -p /kaniko/.docker
                            echo '{"credsStore":"ecr-login"}' > /kaniko/.docker/config.json
                            /kaniko/executor \\
                                --context \$(pwd)/app-service \\
                                --dockerfile \$(pwd)/app-service/Dockerfile \\
                                --destination ${ecrImageUri}
                        """
                        env.ECR_IMAGE_URI = ecrImageUri
                    }
                }
            }
        }

        // [변경] test 환경을 상시 EC2 배포로 전환하면서, replicas 켜고 끄는 로직 자체가
        // 필요 없어짐. prod와 동일하게 이미지 태그만 반영하면 됨.
        stage('4. GitOps 테스트 환경 반영') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        deployToGitOps(
                            'kubernetes/apps/app-service-test/deployment.yaml',
                            env.ECR_IMAGE_URI,
                            "app-service-test image update (${env.IMAGE_TAG})",
                            'app-service-test'
                        )
                    }
                }
            }
        }

        // [해결됨] ArgoCD sync 타이밍 이슈: deployToGitOps() 안에서 push 직후
        // 곧바로 해당 Application에 hard-refresh 어노테이션을 걸어서, 3분 polling을
        // 기다리지 않고 즉시 ArgoCD가 재확인 & sync하도록 강제함.
        stage('5. 테스트 환경 배포 대기') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    sh "kubectl rollout status deployment/app-service -n web-apps-test --timeout=300s"
                }
            }
        }

        stage('6. 배포 승인 대기 (QA)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                script {
                    // 24시간 내 승인 안 할 시 자동 만료 (파이프라인 Abort)
                    timeout(time: 24, unit: 'HOURS') {
                        input message: "테스트 환경(web-apps-test) QA가 완료되었습니다. 상용(app-service-prod)에 동일 이미지(${env.IMAGE_TAG})를 배포할까요?",
                              ok: '배포 진행',
                              submitterParameter: 'DEPLOY_APPROVER'
                    }
                }
            }
        }

        stage('7. GitOps 상용 환경 반영') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        // 배포 직전의 이미지를 기록해둠 - 스모크 테스트 실패 시 이 값으로 자동 롤백
                        env.PROD_PREV_IMAGE_URI = deployToGitOps(
                            'kubernetes/apps/app-service-prod/rollout.yaml',
                            env.ECR_IMAGE_URI,
                            "app-service-prod image update (${env.IMAGE_TAG}) - approved by ${env.DEPLOY_APPROVER}",
                            'app-service-prod'
                        )
                    }
                }
            }
        }

        // [카나리 전환] 기존 8단계(rollout status) + 8.5단계(스모크 테스트+롤백)를 통합 대체.
        // Rollouts가 10% 트래픽 단계에서 Prometheus 성공률(AnalysisTemplate)로 자동 판정하므로
        // 파드 하나에 wget 한번 날리던 기존 스모크 테스트보다 강력함.
        // 분석 실패 시 Rollouts가 즉시 abort하고 트래픽을 stable로 되돌리지만,
        // git의 desired 이미지는 여전히 새 버전이라 Degraded로 남음 —
        // GitOps 정합성을 위해 이전 이미지로 revert 커밋까지 수행함.
        stage('8. 카나리 배포 진행 확인 (실패 시 자동 롤백)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        // steps 전체 소요: 분석 ~2.5분 + pause 60초 + 파드 기동 — 여유있게 15분
                        def canaryResult = sh(
                            script: "kubectl argo rollouts status app-service -n web-apps --timeout 900s",
                            returnStatus: true
                        )

                        if (canaryResult != 0) {
                            if (env.PROD_PREV_IMAGE_URI == null || env.PROD_PREV_IMAGE_URI.contains("placeholder")) {
                                error("카나리 실패 - 되돌릴 이전 정상 버전이 없어(최초 배포) git 롤백을 건너뜀. 수동 확인 필요.")
                            }
                            echo "카나리 분석 실패 감지 - 이전 버전(${env.PROD_PREV_IMAGE_URI})으로 git 롤백합니다."
                            deployToGitOps(
                                'kubernetes/apps/app-service-prod/rollout.yaml',
                                env.PROD_PREV_IMAGE_URI,
                                "ROLLBACK: 카나리 분석 실패로 자동 롤백 (${env.IMAGE_TAG} 배포 취소)",
                                'app-service-prod'
                            )
                            // revert 커밋이 반영되면 desired == stable이 되어 Rollout이 Healthy로 복귀
                            sh "kubectl argo rollouts status app-service -n web-apps --timeout 300s"
                            error("카나리 분석 실패 - 이전 버전(${env.PROD_PREV_IMAGE_URI})으로 롤백 완료. ${env.IMAGE_TAG} 배포는 취소됨.")
                        } else {
                            echo "카나리 배포 성공 - 100% 전환 완료 (${env.IMAGE_TAG})"
                        }
                    }
                }
            }
        }

    }
}

// gitops-repo를 clone -> sed로 이미지 태그 치환 -> commit/push
// targetDeploymentPath: gitops-repo 루트 기준 상대 경로 (예: kubernetes/apps/app-service-prod/deployment.yaml)
// imageUri: 반영할 이미지 URI (새 배포든, 롤백용 이전 이미지든 여기로 넘김)
// argoAppName: ArgoCD Application 이름. push 직후 이 Application을 hard-refresh 시켜서
//              3분 polling을 기다리지 않고 즉시 sync 여부를 재판단하게 만듦.
// 반환값: 교체되기 전 이미지 URI (롤백 시 이 값으로 되돌리기 위해 호출부에서 기록해둠)
def deployToGitOps(String targetDeploymentPath, String imageUri, String commitMsg, String argoAppName) {
    def prevImageFile = "prev_image_${argoAppName}.txt"
    withCredentials([usernamePassword(credentialsId: 'gitlab-checkout-cred', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
        sh """
            git config --global user.email "jenkins@jenkins.com"
            git config --global user.name "Jenkins-CI"
            git config --global http.sslVerify false
            rm -rf gitops-repo-tmp
            CLEAN_PASSWORD=\$(echo -n "\${GIT_PASSWORD}" | tr -d '\\n\\r')
            CLEAN_USERNAME=\$(echo -n "\${GIT_USERNAME}" | tr -d '\\n\\r')
            git clone -b main "http://\${CLEAN_USERNAME}:\${CLEAN_PASSWORD}@10.0.4.10:8080/root/gitops-repo.git" gitops-repo-tmp
            grep "image:" gitops-repo-tmp/${targetDeploymentPath} | awk '{print \$2}' > ${prevImageFile}
            sed -i "s|image: .*|image: ${imageUri}|g" gitops-repo-tmp/${targetDeploymentPath}
            cd gitops-repo-tmp
            git add ${targetDeploymentPath}
            git commit -m "${commitMsg}"
            git push origin main
        """
    }

    // push만으로는 ArgoCD가 최대 3분(polling 주기) 뒤에나 변경을 감지할 수 있어서,
    // 바로 다음 stage의 rollout status가 timeout날 위험이 있었음.
    // hard-refresh 어노테이션을 걸어서 즉시 재비교 + sync를 강제로 유도함.
    sh """
        kubectl patch application ${argoAppName} -n argocd --type merge \
            -p '{"metadata":{"annotations":{"argocd.argoproj.io/refresh":"hard"}}}'
    """

    return readFile(prevImageFile).trim()
}
