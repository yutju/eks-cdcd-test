pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
  namespace: jenkins-build
spec:
  serviceAccountName: jenkins-build-agent
  containers:
  - name: kubectl
    image: alpine:latest
    command: ["sleep"]
    args: ["infinity"]
    securityContext:
      runAsUser: 0
    envFrom:
    - configMapRef:
        name: jenkins-infra-config
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["infinity"]
  # [신규] Trivy 시크릿/이미지 취약점 스캔 전용 컨테이너
  - name: trivy
    image: aquasec/trivy:latest
    command: ["sleep"]
    args: ["infinity"]
    resources:
      requests:
        memory: "512Mi"
        cpu: "200m"
      limits:
        memory: "1Gi"
  # [DR] Azure CLI — ACA(Container Apps) 이미지 갱신용 (5단계).
  #   관리 평면(management.azure.com) 호출. Service Principal 비대면 로그인.
  - name: azcli
    image: mcr.microsoft.com/azure-cli:latest
    command: ["sleep"]
    args: ["infinity"]
    resources:
      requests:
        memory: "256Mi"
        cpu: "100m"
      limits:
        memory: "512Mi"
"""
        }
    }
    // [신규] 동시 빌드 금지 — 두 빌드가 동시에 gitops-repo에 push하면 꼬이므로
    options {
        disableConcurrentBuilds()
    }
    environment {
        GITLAB_API_TOKEN    = credentials('gitlab-token-id')
        GITLAB_URL          = "${env.GITLAB_URL ?: 'http://10.0.4.10:8080'}"
        GITLAB_PROJECT_ID   = "root%2Fapp-repo"
        JENKINS_WEBHOOK_BASE_URL = "http://jenkins.his-main.internal:8080/generic-webhook-trigger/invoke"
        GENERIC_TRIGGER_TOKEN    = "jenkins-openemr-secret"
        AWS_REGION          = "ap-northeast-2"
        ECR_REPO_NAME       = "openemr"
        IMAGE_TAG           = "${BUILD_NUMBER}"
        // [DR] ACR 자격증명 SSM 파라미터 경로 (login_server/username/password)
        ACR_SSM_PREFIX      = "/his-main/acr"
        // [DR] Azure Service Principal도 SSM에서 직접 조회 (ACR과 동일 패턴).
        //   → Jenkins Credentials 등록 불필요 = 시작 단계 credentials() 실패 없음.
        //   → Azure 인프라 재배포 시에도 SSM가 자동 동기화되어 권한 유실 없음.
        //   경로: ${AZURE_SSM_PREFIX}/azure_tenant_id | azure_client_id | azure_client_secret(SecureString)
        AZURE_SSM_PREFIX    = "/his-main/jenkins"
        // [DR] Azure Container Apps 대상 (Warm Standby)
        ACA_NAME            = "his-main-dr-app"
        ACA_RG              = "his-main-dr-rg"
    }
    // [변경] openemr/ 변경 없으면 빌드 자체가 시작 안 됨
    // [수정] app-service와 동일하게 main 브랜치로 제한 ($ref 포함).
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added', value: '$.commits[*].added[*]'],
                [key: 'removed', value: '$.commits[*].removed[*]']
            ],
            causeString: 'GitLab push 감지 (openemr 경로 필터)',
            token: 'jenkins-openemr-secret',
            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            regexpFilterText: '$ref $modified $added $removed',
            regexpFilterExpression: '^refs/heads/main.*openemr/.*$'
        )
    }
    stages {
        stage('0. 기본 에이전트 도구 주입') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl openssl bash git aws-cli
                        curl -sLO "https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                    '''
                }
            }
        }
        stage('1. 코드 체크아웃') {
            steps {
                container('kubectl') {
                    checkout scm
                }
            }
        }
        stage('1.5 변경 경로 확인') {
            steps {
                container('kubectl') {
                    script {
                        def changed = sh(
                            script: '''
                                if git rev-parse --verify HEAD~1 >/dev/null 2>&1; then
                                    git diff --name-only HEAD~1 HEAD
                                else
                                    echo "__FULL_BUILD__"
                                fi
                            ''',
                            returnStdout: true
                        ).trim()
                        if (changed == "__FULL_BUILD__") {
                            echo "비교 기준 커밋 없음(첫 커밋/얕은 클론) — 안전하게 빌드 진행"
                            env.APP_CHANGED = 'true'
                        } else if (changed.contains('openemr/')) {
                            env.APP_CHANGED = 'true'
                        } else {
                            echo "openemr 변경 없음 — 이후 스테이지 스킵"
                            env.APP_CHANGED = 'false'
                        }
                    }
                }
            }
        }
        // [신규] 시크릿 스캔 — 소스(openemr/)에 하드코딩된 자격증명이 커밋됐는지 검사.
        // 발견 시 빌드 차단. 오탐은 openemr/.trivyignore 에 룰 ID 등록으로 예외 처리.
        stage('1.7 Trivy 시크릿 스캔') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('trivy') {
                    sh """
                        trivy fs --scanners secret --exit-code 1 --no-progress openemr/
                    """
                }
            }
        }
        // [수정] 훅 중복확인 grep을 토큰 기준으로 — 베이스 URL은 app-service 파이프라인과 동일해서
        //   토큰 없는 매칭이면 서로의 훅을 "이미 있음"으로 오판해 자기 훅 등록을 건너뜀.
        stage('2. GitLab 웹훅 자동 등록') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        def gitlabApiBase = "${env.GITLAB_URL}/api/v4"
                        sh """
                            EXISTING_HOOK=\$(curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --silent "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" | grep "token=${env.GENERIC_TRIGGER_TOKEN}" || true)
                            if [ -z "\$EXISTING_HOOK" ]; then
                                curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --request POST -G "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" \\
                                    --data-urlencode "url=${env.JENKINS_WEBHOOK_BASE_URL}?token=${env.GENERIC_TRIGGER_TOKEN}" \\
                                    --data-urlencode "push_events=true" \\
                                    --data-urlencode "enable_ssl_verification=false"
                            fi
                        """
                    }
                }
            }
        }
        // [DR 통합] 한 번 빌드로 AWS ECR + Azure ACR 동시 push (Kaniko 멀티 목적지).
        //   - ECR : ecr-login 헬퍼(credHelpers)로 인증 (kaniko debug 이미지에 내장)
        //   - ACR : SSM에 보관된 admin 자격증명으로 static basic auth
        //   ※ ACR은 폐쇄망이라, 이 에이전트(AWS VPC 내 EKS)에서만 도달 가능해야 함
        //   ※ openemr/Dockerfile 이 존재해야 빌드됨
        stage('3. Docker Image Build & Multi-Registry Push (ECR + Azure ACR)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                script {
                    def awsAccountId  = ''
                    def acrLoginServer = ''
                    def ecrRegistry    = ''
                    container('kubectl') {
                        awsAccountId   = sh(script: "aws sts get-caller-identity --query 'Account' --output text", returnStdout: true).trim()
                        acrLoginServer = sh(script: "aws ssm get-parameter --name '${env.ACR_SSM_PREFIX}/login_server' --query 'Parameter.Value' --output text", returnStdout: true).trim()
                        ecrRegistry    = "${awsAccountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        // ACR 자격증명(username/password)을 SSM에서 꺼내 kaniko용 docker config 생성.
                        // set +x 로 비밀번호가 콘솔 로그에 찍히지 않게 함.
                        sh """
                            set +x
                            ACR_USERNAME=\$(aws ssm get-parameter --name '${env.ACR_SSM_PREFIX}/username' --query 'Parameter.Value' --output text)
                            ACR_PASSWORD=\$(aws ssm get-parameter --name '${env.ACR_SSM_PREFIX}/password' --with-decryption --query 'Parameter.Value' --output text)
                            ACR_AUTH=\$(printf '%s:%s' "\$ACR_USERNAME" "\$ACR_PASSWORD" | base64 | tr -d '\\n')
                            printf '{"credHelpers":{"%s":"ecr-login"},"auths":{"%s":{"auth":"%s"}}}' \\
                                "${ecrRegistry}" "${acrLoginServer}" "\$ACR_AUTH" > "\$(pwd)/kaniko-docker-config.json"
                            set -x
                            echo "docker config 생성 완료 (ECR: ${ecrRegistry}, ACR: ${acrLoginServer})"
                        """
                    }
                    container('kaniko') {
                        def ecrImageUri = "${ecrRegistry}/${env.ECR_REPO_NAME}:${env.IMAGE_TAG}"
                        def acrImageUri = "${acrLoginServer}/${env.ECR_REPO_NAME}:${env.IMAGE_TAG}"
                        def acrLatest   = "${acrLoginServer}/${env.ECR_REPO_NAME}:latest"
                        sh """
                            mkdir -p /kaniko/.docker
                            cp "\$(pwd)/kaniko-docker-config.json" /kaniko/.docker/config.json
                            /kaniko/executor \\
                                --context \$(pwd)/openemr \\
                                --dockerfile \$(pwd)/openemr/Dockerfile \\
                                --destination ${ecrImageUri} \\
                                --destination ${acrImageUri} \\
                                --destination ${acrLatest}
                        """
                        env.ECR_IMAGE_URI = ecrImageUri
                        env.ACR_IMAGE_URI = acrImageUri
                        env.ACR_IMAGE_LATEST = acrLatest   // [DR] 5단계 ACA가 바라보는 warm-standby 태그
                        echo "푸시 완료 → ECR: ${ecrImageUri} / ACR: ${acrImageUri} (+ ${acrLatest})"
                    }
                }
            }
        }
        // [신규] 이미지 취약점 스캔 게이트 — HIGH 이상 리포트, CRITICAL 있으면 빌드 실패.
        //   기본 출력이 모든 package.json을 clean으로 도배하므로, 'Total:'부터만 출력해 간결화.
        //   게이트는 출력 버리고 exit code만 사용. 시크릿은 1.7에서 했으니 --scanners vuln.
        //   [수정] 리포트는 전체 노출(가시성 유지), 게이트에만 openemr/.trivyignore 적용 →
        //     upstream openemr 이미지가 번들한 수용된 CVE(예: Spring4Shell)는 통과시키되,
        //     .trivyignore 에 없는 '새' CRITICAL 은 그대로 차단.
        stage('3.5 Trivy 이미지 취약점 스캔') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('trivy') {
                    sh """
                        trivy image --severity HIGH,CRITICAL --no-progress --scanners vuln \\
                            --exit-code 0 ${env.ECR_IMAGE_URI} > trivy-report.txt 2>&1 || true
                        echo "───── Trivy HIGH/CRITICAL 취약점 상세 (수용 CVE는 openemr/.trivyignore 참조) ─────"
                        if grep -q "Total:" trivy-report.txt; then
                            sed -n '/Total:/,\$p' trivy-report.txt
                        else
                            echo "HIGH/CRITICAL 취약점 없음"
                        fi
                        echo "────────────────────────────────────────────"
                        trivy image --severity CRITICAL --no-progress --scanners vuln \\
                            --ignorefile openemr/.trivyignore \\
                            --exit-code 1 --quiet ${env.ECR_IMAGE_URI} > /dev/null 2>&1
                    """
                }
            }
        }
        // GitOps 반영(AWS 배포) + ACA 갱신(Azure DR). 승인 게이트 없이 자동 진행.
        stage('4. GitOps 레포 자동 수정 및 푸시 (AWS 배포)') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'gitlab-checkout-cred', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                            sh """
                                git config --global user.email "jenkins@jenkins.com"
                                git config --global user.name "Jenkins-CI"
                                git config --global http.sslVerify false
                                rm -rf gitops-repo-tmp
                                CLEAN_PASSWORD=\$(echo -n "\${GIT_PASSWORD}" | tr -d '\\n\\r')
                                CLEAN_USERNAME=\$(echo -n "\${GIT_USERNAME}" | tr -d '\\n\\r')
                                set +x
                                git clone -b main "http://\${CLEAN_USERNAME}:\${CLEAN_PASSWORD}@10.0.4.10:8080/root/gitops-repo.git" gitops-repo-tmp
                                set -x
                                sed -i "s|image: .*|image: ${env.ECR_IMAGE_URI}|g" gitops-repo-tmp/kubernetes/apps/openemr/deployment.yaml
                                cd gitops-repo-tmp
                                git add kubernetes/apps/openemr/deployment.yaml
                                git commit -m "openemr image: ECR 이미지 업데이트 (Build #${env.IMAGE_TAG})"
                                set +x
                                git push origin main || (git pull --rebase origin main && git push origin main)
                                set -x
                            """
                        }
                    }
                }
            }
        }
        // [DR] Azure Container Apps 이미지 갱신 (문서 Phase 2 - 4단계 반영).
        //   상시 대기(Warm Standby) 중인 ACA(his-main-dr-app)의 이미지를 방금 ACR에 push한
        //   실제 서비스 이미지(:latest)로 즉각 교체 → DR 전환 시 지연 최소화.
        //   - Azure SP 자격증명은 SSM에서 조회(kubectl 컨테이너, aws-cli) → 공유 워크스페이스
        //     파일(azure-sp.env)로 전달 → azcli 컨테이너가 읽어 az login. (컨테이너 간 env 미전달이라
        //     ACR 3단계와 동일하게 파일 경유. set +x 로 secret 로그 억제.)
        //   - 에이전트가 EKS(AWS VPC 내부)에서 실행 → 문서의 '내부망 러너' 요건 충족
        //   ※ 전제1: jenkins_agent IAM 역할이 ${AZURE_SSM_PREFIX}/* 조회 + kms:Decrypt 가능해야 함
        //   ※ 전제2: ACA가 ACR에서 pull할 권한(관리 ID 또는 admin 자격증명) 사전 구성
        stage('5. Azure DR: ACA 이미지 갱신') {
            when { environment name: 'APP_CHANGED', value: 'true' }
            steps {
                container('kubectl') {
                    sh """
                        set -e
                        set +x
                        AZURE_TENANT_ID=\$(aws ssm get-parameter --name '${env.AZURE_SSM_PREFIX}/azure_tenant_id' --query 'Parameter.Value' --output text)
                        AZURE_CLIENT_ID=\$(aws ssm get-parameter --name '${env.AZURE_SSM_PREFIX}/azure_client_id' --query 'Parameter.Value' --output text)
                        AZURE_CLIENT_SECRET=\$(aws ssm get-parameter --name '${env.AZURE_SSM_PREFIX}/azure_client_secret' --with-decryption --query 'Parameter.Value' --output text)
                        if [ -z "\$AZURE_TENANT_ID" ] || [ -z "\$AZURE_CLIENT_ID" ] || [ -z "\$AZURE_CLIENT_SECRET" ]; then
                            echo 'ERROR: Azure SP 자격증명이 비어있음 — jenkins_agent 역할에 ${env.AZURE_SSM_PREFIX}/* SSM 조회 권한을 확인하세요.'
                            exit 1
                        fi
                        {
                          echo "AZURE_TENANT_ID=\$AZURE_TENANT_ID"
                          echo "AZURE_CLIENT_ID=\$AZURE_CLIENT_ID"
                          echo "AZURE_CLIENT_SECRET=\$AZURE_CLIENT_SECRET"
                        } > "\$(pwd)/azure-sp.env"
                        chmod 600 "\$(pwd)/azure-sp.env"
                        set -x
                        echo "Azure SP 자격증명 로드 완료 (SSM: ${env.AZURE_SSM_PREFIX})"
                    """
                }
                container('azcli') {
                    sh """
                        set +x
                        . "\$(pwd)/azure-sp.env"
                        az login --service-principal \\
                            -u "\$AZURE_CLIENT_ID" -p "\$AZURE_CLIENT_SECRET" --tenant "\$AZURE_TENANT_ID" >/dev/null
                        rm -f "\$(pwd)/azure-sp.env"
                        set -x
                        az containerapp update \\
                            --name "${env.ACA_NAME}" \\
                            --resource-group "${env.ACA_RG}" \\
                            --image "${env.ACR_IMAGE_LATEST}"
                        echo "Azure DR(ACA) 갱신 완료 → ${env.ACA_NAME} = ${env.ACR_IMAGE_LATEST}"
                    """
                }
            }
        }
    }
}
