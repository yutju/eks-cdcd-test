apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
  #  [수정 1] Fargate Profile 라우팅을 위한 네임스페이스 주석 해제 완료
  namespace: jenkins-build
spec:
  # [수정 2] 해당 네임스페이스에 맞게 서비스 어카운트 이름 변경 (이전에 생성한 SA)
  serviceAccountName: jenkins-build-agent
  containers:
  # 파이프라인 제어 및 AWS CLI/K8s 명령어를 실행하기 위한 유틸리티 컨테이너
  - name: kubectl
    image: alpine:latest
    command: ["sleep"]
    args: ["infinity"]
    securityContext:
      runAsUser: 0
    envFrom:
    - configMapRef:
        name: jenkins-infra-config

  # 특권(Privileged) 권한 및 도커 데몬 없이 컨테이너 이미지를 빌드/푸시하기 위한 Kaniko 컨테이너
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["infinity"]
"""
        }
    }

    environment {
        // GitLab 연동 및 웹훅 구성을 위한 환경 변수
        GITLAB_API_TOKEN = credentials('gitlab-token-id')
        GITLAB_URL       = "${env.GITLAB_URL}"
        GITLAB_PROJECT_ID = "root%2Fapp-repo"
        JENKINS_WEBHOOK_URL = "http://${env.JENKINS_IP}:${env.JENKINS_PORT}/project/jenkins-test-pipeline"

        // AWS ECR 대상 레지스트리 및 빌드될 이미지 태그 설정
        AWS_ACCOUNT_ID = "407002402096"
        AWS_REGION     = "ap-northeast-2"
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO_NAME  = "dev-apps/hello-k3s"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        ECR_IMAGE_URI  = "${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"
    }

    triggers {
        // GitLab에서 Push 또는 Merge Request 발생 시 자동으로 파이프라인을 트리거
        gitlab(triggerOnPush: true, triggerOnMergeRequest: true, branchFilterType: 'All', secretToken: 'jenkins-test-secret')
    }

    stages {
        stage('0. 기본 에이전트 도구 주입') {
            steps {
                container('kubectl') {
                    // 파이프라인 실행에 필요한 패키지(AWS CLI, Git 등) 및 kubectl 수동 설치
                    sh """
                    apk add --no-cache curl openssl bash git aws-cli > /dev/null
                    curl -sLO "https://dl.k8s.io/release/v1.29.0/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                    mv kubectl /usr/local/bin/
                    """
                }
            }
        }

        stage('1. 코드 체크아웃') {
            steps { checkout scm }
        }

        stage('2. GitLab 웹훅 자동 등록') {
            steps {
                container('kubectl') {
                    script {
                        // GitLab API를 호출하여 현재 파이프라인의 웹훅이 등록되어 있는지 확인 후, 없으면 자동 등록
                        def gitlabApiBase = "${env.GITLAB_URL}/api/v4"
                        sh """
                        EXISTING_HOOK=\$(curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --silent "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks" | grep "${env.JENKINS_WEBHOOK_URL}" || true)
                        if [ -z "\$EXISTING_HOOK" ]; then
                            curl --header "PRIVATE-TOKEN: ${env.GITLAB_API_TOKEN}" --request POST "${gitlabApiBase}/projects/${env.GITLAB_PROJECT_ID}/hooks?url=${env.JENKINS_WEBHOOK_URL}&push_events=true&token=jenkins-test-secret&enable_ssl_verification=false"
                        fi
                        """
                    }
                }
            }
        }

        stage('3. Docker Image Build & ECR Push (Kaniko)') {
            steps {
                container('kaniko') {
                    script {
                        // EKS의 IAM Role(IRSA)을 통해 자동 인증 수행
                        sh """
                            mkdir -p /kaniko/.docker
                            echo '{"credsStore":"ecr-login"}' > /kaniko/.docker/config.json

                            /kaniko/executor \
                                --context `pwd` \
                                --dockerfile `pwd`/Dockerfile \
                                --destination ${ECR_IMAGE_URI}
                        """
                    }
                }
            }
        }

        // [수정 3] Stage 4 (ECR Secret 생성) 완전히 제거 완료

        stage('4. GitOps 레포 자동 수정 및 푸시') {
            steps {
                container('kubectl') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'gitlab-checkout-cred', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                            // [수정 4] 하드코딩된 내부 도메인 대신, 앞서 설정한 env.GITLAB_URL을 사용해 안정적으로 클론
                            sh """
                                git config --global user.email "jenkins@jenkins.com"
                                git config --global user.name "Jenkins-CI"
                                git config --global http.sslVerify false

                                rm -rf gitops-repo-tmp
                                
                                # env.GITLAB_URL에 계정 정보를 삽입하여 클론
                                GIT_REPO_URL=\$(echo ${env.GITLAB_URL} | sed "s|http://|http://\${GIT_USERNAME}:\${GIT_PASSWORD}@|")/root/gitops-repo.git
                                git clone -b main "\$GIT_REPO_URL" gitops-repo-tmp

                                sed -i "s|image: .*|image: ${ECR_IMAGE_URI}|g" gitops-repo-tmp/kubernetes/apps/app/test-deployment.yaml

                                cd gitops-repo-tmp
                                git add kubernetes/apps/app/test-deployment.yaml
                                git commit -m "image: ECR 이미지 업데이트 (Build #${IMAGE_TAG})"
                                git push origin main
                            """
                        }
                    }
                }
            }
        }
    }
}
